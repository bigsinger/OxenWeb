# For an existing server, set these values. Local seed writes infra/oxen/local.env.
HOST=127.0.0.1
PORT=3001
DEMO_MODE=false
OXEN_SERVER_URL=http://127.0.0.1:3002
OXEN_NAMESPACES=local
# Defaults are discovered from this checkout. Use an absolute CLI executable path
# only when connecting an externally installed Oxen CLI.
# OXEN_CLI_BIN=oxen
# OXEN_CLI_ROOT=.data/clones
# OXEN_CONFIG_DIR=/absolute/path/to/your/oxen-client-config
# BFF_TOKEN=set-your-own-long-random-token
# Team deployments must enable this and set the protected owner token above.
# BFF_TEAM_MODE=true
# BFF_ALLOWED_HOSTS=localhost,127.0.0.1,::1
SECURE_COOKIES=false
OXEN_CLI_TIMEOUT_MS=120000
